{$VAMZ_DOMAIN} {
  encode zstd gzip
  request_body {
    max_size 1GB
  }
  reverse_proxy app:3000 {
    header_up X-Real-IP {remote_host}
  }
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    Strict-Transport-Security "max-age=31536000"
    -Server
  }
}
